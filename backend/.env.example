# =============================================================================
# Local development — copy to .env and fill in real values
# =============================================================================

NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/aarambh?retryWrites=true&w=majority
# Optional: if Node reports querySrv ECONNREFUSED on Windows, public DNS is used automatically.
# Override with: MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=3650d

# Brevo API (recommended — no SMTP IP whitelist issues)
BREVO_API_KEY=your_xkeysib_api_key
SMTP_FROM=your_verified_sender@gmail.com
BREVO_SENDER_NAME=Ohm's English

# Optional SMTP fallback — https://app.brevo.com → SMTP & API
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_login@smtp-brevo.com
SMTP_PASS=your_brevo_smtp_key

CLIENT_URL=*

# Admin dashboard login (User ID + password — not Gmail)
ADMIN_USERNAME=Aarambh@12342
ADMIN_PASSWORD=your_admin_password
ADMIN_DB_EMAIL=aarambh-admin@system.local
ADMIN_TOKEN_EXPIRY=24h

KEEP_ALIVE_ENABLED=false
# Production (Render): set KEEP_ALIVE_ENABLED=true and KEEP_ALIVE_URL=https://aarambh-api.onrender.com
# KEEP_ALIVE_INTERVAL_MS=60000

# Google Play review login only (optional — does not affect normal users)
# PLAY_REVIEWER_EMAIL=ohmsplayreview@gmail.com
# PLAY_REVIEWER_OTP=847291

# Razorpay (Pro subscription — ₹249/month)
# Dashboard → https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# App update prompt (Android / Play Store)
# Increase these after publishing a new Play Store build.
ANDROID_PACKAGE_NAME=com.ohms.english
ANDROID_MIN_VERSION=1.0.1
ANDROID_LATEST_VERSION=1.0.1
ANDROID_MIN_BUILD_NUMBER=2
ANDROID_LATEST_BUILD_NUMBER=2
ANDROID_FORCE_UPDATE=1
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.ohms.english
APP_UPDATE_MESSAGE=A new version of Ohm's English is available. Please update from the Play Store to continue.
