NODE_ENV=production

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/aarambh?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=replace_with_another_openssl_rand_base64_48
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=3650d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password_no_spaces

CLIENT_URL=*

ADMIN_USERNAME=Aarambh@12342
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_DB_EMAIL=aarambh-admin@system.local

KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_URL=https://aarambh-api.onrender.com
KEEP_ALIVE_INTERVAL_MS=60000

# Google Play review — create this Gmail yourself, then set same values in Render Dashboard
PLAY_REVIEWER_EMAIL=ohmsplayreview@gmail.com
PLAY_REVIEWER_OTP=847291

# Razorpay (Pro subscription payments)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Firebase Cloud Messaging
# Recommended on Render: paste the full service account JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
#
# Alternative: split keys (private key must stay on ONE line with literal \n characters)
FIREBASE_PROJECT_ID=ohms-english-learning
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@ohms-english-learning.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
# Optional: base64-encoded PEM instead of FIREBASE_PRIVATE_KEY
# FIREBASE_PRIVATE_KEY_B64=base64_of_entire_pem_file
# Generate Render values locally:
# node scripts/prepare-firebase-render-env.js path/to/serviceAccountKey.json
DAILY_NOTIFICATION_SCHEDULE=30 4 * * *
SEND_TEST_NOTIFICATION_ON_STARTUP=false

# Account Deletion Cleanup (runs daily to permanently delete expired accounts)
ACCOUNT_DELETION_SCHEDULE=0 2 * * *
RUN_DELETION_CLEANUP_ON_STARTUP=false

# App update prompt (Android / Play Store)
# Example: when Play Store has versionCode 3, set LATEST_BUILD_NUMBER=3.
# Set MIN_BUILD_NUMBER=3 only when old builds must be blocked.
ANDROID_PACKAGE_NAME=com.ohms.english
ANDROID_MIN_VERSION=1.0.1
ANDROID_LATEST_VERSION=1.0.1
ANDROID_MIN_BUILD_NUMBER=2
ANDROID_LATEST_BUILD_NUMBER=2
ANDROID_FORCE_UPDATE=1
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.ohms.english
APP_UPDATE_MESSAGE=A new version of Ohm's English is available. Please update from the Play Store to continue.
