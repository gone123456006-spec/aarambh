# Render production API (primary — works on any network)
EXPO_PUBLIC_REMOTE_API_URL=https://aarambh-api.onrender.com

# Local PC backend (same Wi‑Fi; npm run sync-api updates IP)
EXPO_PUBLIC_API_URL=http://192.168.1.5:5000
EXPO_PUBLIC_API_PORT=5000

# Optional TURN for video/voice calls on strict mobile networks (Metered, Twilio, coturn, etc.)
# EXPO_PUBLIC_TURN_URL=turn:global.turn.example.com:3478?transport=udp
# EXPO_PUBLIC_TURN_USERNAME=your_turn_username
# EXPO_PUBLIC_TURN_CREDENTIAL=your_turn_credential
