# ============================================================
# .easignore — files excluded from EAS Build archive upload
# Uses .gitignore syntax. EAS regenerates native folders on
# the build server, so we exclude them entirely to keep the
# upload small and avoid ENOENT errors from stale Gradle
# intermediates (.flat files, merged_res, etc.)
# ============================================================

# ── Native build outputs (CRITICAL — prevents ENOENT errors) ──
android/app/build/
android/build/
android/.gradle/
**/build/intermediates/
**/build/outputs/
**/merged_res/
**/*.flat
**/intermediates/

# ── Entire native folders (regenerated by EAS on the server) ──
/android/
/ios/

# ── JS / Metro cache ──
node_modules/
.expo/
.expo-tmp-export/
dist/
dist-*/
web-build/

# ── Dev / docs ──
**/*.md
play-console-assets/

# ── Large log files ──
build_out.txt
bundle_log.txt

# ── Local env secrets ──
.env
.env*.local
.env.local
